# Copy to .env and edit:  cp .env.EXAMPLE .env
# Docker Compose reads this file automatically.

# Which services to run on this machine (comma-separated).
# Both on one host:  ollama,open-webui
# Ollama host only:  ollama
# WebUI host only:   open-webui
COMPOSE_PROFILES=ollama,open-webui

# Host ports published on 0.0.0.0.
WEBUI_PORT=3060
OLLAMA_PORT=11434

# If true, systemd waits for wireguard-vpn.service before starting.
# Re-run sudo ./install_service.sh after changing this.
WAIT_FOR_WIREGUARD=true

# Where Open WebUI should reach Ollama.
# Same compose network: http://ollama:11434
# Ollama on another host:  http://192.168.1.10:11434
OLLAMA_BASE_URL=http://ollama:11434