# Copy to .env and edit:  cp .env.EXAMPLE .env
# Docker Compose reads this file automatically.

# Which services to run on this machine (comma-separated).
# Both on one host:  ollama,open-webui
# Ollama host only:  ollama
# WebUI host only:   open-webui
COMPOSE_PROFILES=ollama,open-webui

# Host ports published on 0.0.0.0 (WireGuard DNATs here; the host has no 10.0.2.x).
# WEBUI_PORT should match WireGuard BACKEND_PORT (default 3060) if this is the UI host.
# OLLAMA_PORT needs a matching WireGuard DNAT if you reach the API over the VPN.
WEBUI_PORT=3060
OLLAMA_PORT=11434

# Where Open WebUI should reach Ollama.
# Same compose network: http://ollama:11434
# Ollama on another host:  http://10.0.2.3:11434
OLLAMA_BASE_URL=http://ollama:11434